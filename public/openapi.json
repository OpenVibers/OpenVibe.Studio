{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenVibe.Studio",
    "version": "0.1.0",
    "description": "Photo and Light: two open-source creative apps built from pinned release tags and served inside an OpenVibe account."
  },
  "servers": [
    {
      "url": "https://openvibe.studio"
    }
  ],
  "paths": {
    "/api/v1/studio/apps": {
      "get": {
        "summary": "The apps Studio serves, their capabilities and their commands.",
        "responses": {
          "200": {
            "description": "The catalogue."
          }
        }
      }
    },
    "/api/v1/studio/files": {
      "get": {
        "summary": "The files and pictures the signed-in person owns.",
        "responses": {
          "200": {
            "description": "Files and pictures, with any source that failed."
          },
          "401": {
            "description": "Sign in required."
          }
        }
      }
    },
    "/api/v1/studio/files/{source}/{id}/bytes": {
      "get": {
        "summary": "The bytes of one file or picture.",
        "parameters": [
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "download",
                "pics"
              ]
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file."
          },
          "401": {
            "description": "Sign in required."
          },
          "501": {
            "description": "The host has no byte route for a person's token."
          }
        }
      }
    },
    "/api/v1/studio/media/{id}/bytes": {
      "get": {
        "summary": "A video's bytes for the Studio editor preview. Video decides whether the signed-in person may read it; Range reads pass through.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The video."
          },
          "206": {
            "description": "The requested range."
          },
          "401": {
            "description": "Sign in required."
          },
          "404": {
            "description": "No such video, or it is not this person's to open."
          }
        }
      }
    },
    "/api/v1/studio/publish": {
      "post": {
        "summary": "Queue a trim of a video as a new copy on OpenVibe.Video (the original is unchanged).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["media", "start", "end"],
                "properties": {
                  "media": { "type": "string", "description": "The OpenVibe.Video id (vup_, /watch?v= id or Media VOD id)." },
                  "start": { "type": "number", "minimum": 0, "description": "Seconds into the video." },
                  "end": { "type": "number", "minimum": 0, "description": "Seconds into the video; at least one second after start." },
                  "cover": { "type": "number", "minimum": 0, "description": "Seconds into the video for the cover frame." },
                  "title": { "type": "string", "maxLength": 120 },
                  "visibility": { "type": "string", "enum": ["private", "unlisted", "public"] }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The trim is queued; poll /api/v1/studio/publish/{id}."
          },
          "401": {
            "description": "Sign in required."
          },
          "404": {
            "description": "No such video, or it is not this person's to publish."
          },
          "422": {
            "description": "The range is under one second, outside the video, or otherwise invalid."
          }
        }
      }
    },
    "/api/v1/studio/publish/{id}": {
      "get": {
        "summary": "How a queued trim is going, and the copy's address when it is done.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The cut: queued, measuring, rendering, done with its result, or failed." },
          "401": { "description": "Sign in required." },
          "404": { "description": "No such edit, or it is not this person's." }
        }
      }
    },
    "/api/v1/studio/save": {
      "post": {
        "summary": "Save a file to the person's OpenVibe.Download drive.",
        "responses": {
          "201": {
            "description": "Saved."
          },
          "401": {
            "description": "Sign in required."
          }
        }
      }
    }
  }
}
