# OpenVibe.Studio environment (production: /etc/openvibe/studio.env; the unit sets NODE_ENV, PORT and HOST).
# The host helper `ov-svc-env studio KEY=VALUE…` creates the env file from this one.
BASE_URL=https://openvibe.studio
TRUST_PROXY=2
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_OAUTH_CLIENT_ID=studio
# Written by Network's service-principal setup (never in a repo).
OV_OAUTH_CLIENT_SECRET=
# Where scripts/fetch-bundles.sh puts the checksummed Photo and Light bundles.
STUDIO_BUNDLE_ROOT=/var/lib/openvibe-studio/apps
# Optional: links to the network's sister sites, and the cookie rule outside production.
# OV_DOWNLOAD_URL=https://openvibe.download
# OV_PICS_URL=https://openvibe.pics
# COOKIE_SECURE=true
